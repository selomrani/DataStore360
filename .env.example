# ==============================================================================
# DATASTORE360 ENVIRONMENT VARIABLES
# ==============================================================================

# PostgreSQL DataStore360 Database
POSTGRES_USER=datastore_admin
POSTGRES_PASSWORD=datastore_secure_pass
POSTGRES_DB=datastore360
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# pgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# Apache Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:2.8.3-python3.10
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# RGPD Pseudonymization Salt
RGPD_SALT=datastore360_super_secret_salt_2026

# Airflow Connection URI (automatically picked up by PostgresHook)
AIRFLOW_CONN_POSTGRES_DATASTORE=postgresql://datastore_admin:datastore_secure_pass@postgres:5432/datastore360
